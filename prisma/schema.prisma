// prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

//
// USUÁRIOS
//
model User {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  image     String?  // foto do Google
  emailVerified DateTime?  // quando o e-mail foi verificado
  phone     String?
  password  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedWorkspaces Workspace[] @relation("WorkspaceOwners")
  calendarAssignments CalendarUser[]

  accounts Account[]
  sessions Session[]
}

//
// ACCOUNT E SESSIONS (NextAuth)
//
model Account {
  id                 Int     @id @default(autoincrement())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

//
// WORKSPACES
//
model Workspace {
  id          Int       @id @default(autoincrement())
  name        String
  logo        String?
  color       String?
  friendlyUrl String    @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owners      User[]       @relation("WorkspaceOwners")
  calendars   Calendar[]
  subscriptions Subscription[]
}

//
// AGENDAS
//
model Calendar {
  id          Int      @id @default(autoincrement())
  workspaceId Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignedUsers CalendarUser[]
  appointments AppointmentMaster[]
}

model CalendarUser {
  id         Int      @id @default(autoincrement())
  calendarId Int
  userId     String
  calendar   Calendar @relation(fields: [calendarId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([calendarId, userId])
}

//
// PLANOS E ASSINATURAS
//
model Plan {
  id       Int     @id @default(autoincrement())
  name     String
  type     String   // BY_SCHEDULES ou BY_CALENDARS
  price    Float
  limits   Json?    // { "maxCalendars": 5, "maxAppointments": 1000 }

  subscriptions Subscription[]
}

model Subscription {
  id          Int       @id @default(autoincrement())
  workspaceId Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  planId      Int
  plan        Plan      @relation(fields: [planId], references: [id])
  startDate   DateTime  @default(now())
  endDate     DateTime?
  active      Boolean   @default(true)
}

//
// CLIENTES FINAIS
//
model Customer {
  id        Int        @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  appointments AppointmentMaster[]
}

//
// AGENDAMENTOS
//
model AppointmentMaster {
  id          Int       @id @default(autoincrement())
  customerId  Int
  customer    Customer  @relation(fields: [customerId], references: [id])
  calendarId  Int
  calendar    Calendar  @relation(fields: [calendarId], references: [id])
  dateTime    DateTime
  status      AppointmentStatus @default(SCHEDULED)

  details   AppointmentDetail[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppointmentDetail {
  id             Int               @id @default(autoincrement())
  appointmentId  Int
  appointment    AppointmentMaster @relation(fields: [appointmentId], references: [id])
  service        String
  status         AppointmentStatus @default(SCHEDULED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//
// ENUM STATUS
//
enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CANCELED
  COMPLETED
}

//
// AUDITORIA
//
model AuditLog {
  id        Int      @id @default(autoincrement())
  entity    String
  entityId  Int
  action    String
  changes   Json?
  userId    String?   // ajustado para String
  createdAt DateTime @default(now())
}
